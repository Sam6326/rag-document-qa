# ─────────────────────────────────────────────────────────────
# RAG Document Q&A App — Environment Variables
# ─────────────────────────────────────────────────────────────
#
# STEP 1: Copy this file and rename it to ".env"
#         On Mac/Linux:  cp .env.example .env
#         On Windows:    copy .env.example .env
#
# STEP 2: Fill in your HuggingFace token (optional but recommended)
#         - Go to: https://huggingface.co/settings/tokens
#         - Create a free account if you don't have one
#         - Click "New token" → name it anything → select "Read" → copy it
#         - Paste it below (replace the placeholder text)
#
# Without a token: app uses google/flan-t5-base (local, free, smaller)
# With a token:    app uses Mistral-7B (via HF API, better answers)
# ─────────────────────────────────────────────────────────────

HUGGINGFACEHUB_API_TOKEN=your_token_here
